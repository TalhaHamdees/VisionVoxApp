# Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Pexels API for media library integration
NEXT_PUBLIC_PEXELS_API_KEY=your_pexels_api_key_here

# API URLs for backend services
NEXT_PUBLIC_SCRIPT_API_URL=http://localhost:8000
NEXT_PUBLIC_AUDIO_API_URL=http://localhost:3001/api/audio

# Google/YouTube API credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_API_KEY=your_google_api_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000 